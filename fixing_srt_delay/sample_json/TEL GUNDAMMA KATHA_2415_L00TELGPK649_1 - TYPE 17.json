{"text": [ "chuttupakkala em dorakavamma." ], "index":77,"start": 292484, "end": 294314 },
{"text": [ "Emaina tinataniki kavalanate maa President", "gariki cheppi intlone vandichestanu." ], "index":78,"start": 294953, "end": 299893 },
{"text": [ "[భువన] Tinadaniki kaadu", "maaku duradaguntaku kavali." ], "index":79,"start": 300934, "end": 304949 },
{"text": [ "[విలేజర్] Duradaguntaka?" ], "index":80,"start": 305074, "end": 306602 },
