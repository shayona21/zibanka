{"text": [ "Nene matladathanu." ], "index":62,"start": 241142, "end": 242378 },
{"text": [ "[మాధవి] Sare." ], "index":63,"start": 242528, "end": 243738 },
{"text": [ "[మానస] Bhuvana. Hm." ], "index":64,"start": 249511, "end": 250777 },
{"text": [ "Aa Pallavini elagaina", "ee first dayne debbakottali" ], "index":65,"start": 252927, "end": 255674 },
