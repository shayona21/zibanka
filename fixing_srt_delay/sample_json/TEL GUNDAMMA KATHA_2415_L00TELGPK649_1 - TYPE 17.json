{"text": [ "[అక్షిత] Okay." ], "index":56,"start": 221045, "end": 222044 },
{"text": [ "[మాధవి] Enti Pallavi?" ], "index":57,"start": 226434, "end": 227433 },
{"text": [ "[పల్లవి] Em ledamma Chandu", "behavior edo tedaga undi." ], "index":58,"start": 228314, "end": 231340 },
{"text": [ "Ammayilatho konchem misbehave chesthunnadu." ], "index":59,"start": 231699, "end": 234282 },
{"text": [ "[మాధవి] Nenu matladana?" ], "index":60,"start": 234451, "end": 235694 },
