{"text": [ "XXX" ], "index":197,"start": 941952, "end": 943633 },
{"text": [ "XXX" ], "index":198,"start": 943835, "end": 947564 },
{"text": [ "XXX" ], "index":199,"start": 948098, "end": 950649 },
{"text": [ "XXX" ], "index":200,"start": 950818, "end": 952425 },
{"text": [ "[చంటి] Nene." ], "index":201,"start": 952515, "end": 953838 },
{"text": [ "SDH [Background Music]" ], "index":202,"start": 953928, "end": 960084 },
{"text": [ "[భువన] Nuvva?", "- [చంటి] Avunu." ], "index":203,"start": 964602, "end": 966144 },
{"text": [ "[చంటి] Meeru techina", "aa bottle marchindi nene." ], "index":204,"start": 966431, "end": 969119 },
{"text": [ "Mee chethula meeda spray chesindi kuda nene." ], "index":205,"start": 973253, "end": 975602 },
{"text": [ "SDH [Background Music]" ], "index":206,"start": 975692, "end": 981712 },
{"text": [ "XXX" ], "index":207,"start": 1026975, "end": 1028691 },
{"text": [ "XXX" ], "index":208,"start": 1028911, "end": 1031693 },
{"text": [ "XXX" ], "index":209,"start": 1033549, "end": 1037201 },
{"text": [ "XXX" ], "index":210,"start": 1041668, "end": 1043310 },
{"text": [ "XXX" ], "index":211,"start": 1043498, "end": 1044962 },
{"text": [ "Aa president assistant ni pilichi" ], "index":212,"start": 1046607, "end": 1048446 },
{"text": [ "meeru vaadito duradaguntaku teppinchadam" ], "index":213,"start": 1048641, "end": 1050602 },
{"text": [ "vaadu meeku theesukuni ivvadam", "bhojanalu ayyaka spray cheddamani" ], "index":214,"start": 1050878, "end": 1054832 },
{"text": [ "meeru bottle lopala pettadam" ], "index":215,"start": 1055142, "end": 1056989 },
{"text": [ "antha nenu observe chesthune unnanu" ], "index":216,"start": 1057306, "end": 1059551 },
{"text": [ "anduke aa bottle nene marchanu" ], "index":217,"start": 1063294, "end": 1066849 },
{"text": [ "meeru vadina meeda spray", "chesindi uttha pasarneellu" ], "index":218,"start": 1068679, "end": 1072055 },
{"text": [ "nenu mee meeda spray chesindi", "meeru techina duradaguntaku rasam." ], "index":219,"start": 1072315, "end": 1076350 },
{"text": [ "[సీత] Rey enduku chesav ra ee pani?" ], "index":220,"start": 1078045, "end": 1079509 },
{"text": [ "[చంటి] Ade nenu adugutunnanu", "mummy vadinani badha pettadaniki" ], "index":221,"start": 1079677, "end": 1083134 },
{"text": [ "enduku ila chesani vallani adagali." ], "index":222,"start": 1083224, "end": 1085416 },
{"text": [ "Adi maanesi" ], "index":223,"start": 1085506, "end": 1086747 },
{"text": [ "nuvvu vallatho chethulu kalipi", "vadinani ibbandi pettalani chusthava?" ], "index":224,"start": 1086837, "end": 1090104 },
{"text": [ "Idhi correct kaadhu mummy." ], "index":225,"start": 1090194, "end": 1091698 },
{"text": [ "[సీత] Edhi correcto edhi", "correct kaado naaku telsu." ], "index":226,"start": 1091909, "end": 1094211 },
{"text": [ "[చంటి] Avuna sare aithe Gundammagarini", "Pallavini Annayani kuda pilusthanu" ], "index":227,"start": 1094301, "end": 1098670 },
{"text": [ "vallaki cheppandi edhi mancho edhi chedo." ], "index":228,"start": 1099166, "end": 1101989 },
{"text": [ "[సీత] Rey rey rey aagura." ], "index":229,"start": 1102421, "end": 1104203 },
{"text": [ "Charan ki cheppoddu." ], "index":230,"start": 1105822, "end": 1107563 },
{"text": [ "[భువన] Avunu Chanti please." ], "index":231,"start": 1108093, "end": 1109680 },
{"text": [ "Edo saradaga aatapattiddamani chesam anthe." ], "index":232,"start": 1110249, "end": 1112771 },
{"text": [ "[చంటి] Aatapattinchadaniki kaadu", "vadinani ibbandi pettalane chusaru." ], "index":233,"start": 1113040, "end": 1117083 },
{"text": [ "Meeru ila badhapadatam", "naaku istam ledu kaani." ], "index":234,"start": 1119474, "end": 1122667 },
{"text": [ "Meeru chesina pani valla avatala", "vallu kuda ilage ibbandi padatharu kada." ], "index":235,"start": 1122757, "end": 1126455 },
{"text": [ "Aa ibbandi ela untundo", "teliyalane nenu ila chesanu" ], "index":236,"start": 1128457, "end": 1132175 },
{"text": [ "inkepudu vadinani ibbandi pettalani", "ilanti pichi pichi veshalu veyoddu." ], "index":237,"start": 1135249, "end": 1139187 },
{"text": [ "Mommy vallake kaadhu neeku chepthunna." ], "index":238,"start": 1140992, "end": 1143774 },
{"text": [ "Jaagrattha." ], "index":239,"start": 1144718, "end": 1146500 },
{"text": [ "Malli ilantivi repeat aithe maatram" ], "index":240,"start": 1148721, "end": 1150948 },
{"text": [ "andarni pilichi andari", "mundu mee vishayalu chepestha." ], "index":241,"start": 1151091, "end": 1154855 },
{"text": [ "SDH [Background Music]" ], "index":242,"start": 1154945, "end": 1160496 },
{"text": [ "XXX" ], "index":243,"start": 1165619, "end": 1170313 },
{"text": [ "SDH [Background Music]" ], "index":244,"start": 1176428, "end": 1182306 }
