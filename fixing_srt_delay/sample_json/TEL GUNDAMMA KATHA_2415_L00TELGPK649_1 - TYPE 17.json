{"text": [ "[భువన] Pada cheptha." ], "index":68,"start": 264597, "end": 266165 },
{"text": [ "[భువన] Anna. Meetho konchem matladali." ], "index":69,"start": 268643, "end": 270262 },
{"text": [ "[విలేజర్] Entamma?", "- [భువన] Ala pakkaki randi cheptha." ], "index":70,"start": 270352, "end": 272500 },
{"text": [ "[విలేజర్] Cheppandamma.", "- [భువన] Em ledu" ], "index":71,"start": 276711, "end": 278377 },
{"text": [ "meeru konchem help chesi pettali." ], "index":72,"start": 278640, "end": 280255 },
{"text": [ "[విలేజర్] Cheppandamma." ], "index":73,"start": 280345, "end": 281628 },
{"text": [ "Meeku em kavalanan chesi pettamani", "maa President garu chepparu kada." ], "index":74,"start": 281908, "end": 285845 },
{"text": [ "[భువన] Aa sare ee dabbulu theesukondi." ], "index":75,"start": 286380, "end": 289022 },
